# ------------------------------------------------------------------
# Contoh konfigurasi — SALIN ke .env, lalu isi dengan nilai Anda.
#   cp .env.example .env
# JANGAN pernah commit .env yang sudah terisi.
# ------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/topup-hgi/'

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = topup_hgi
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# ------------------------------------------------------------------
# K enkripsi (WAJIB di isi)
# Buat kunci baru:
#   php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)) . PHP_EOL;"
# Nilai yang sama persis harus dipakai di setiap instalasi — kalau berubah,
# nilai rahasia yang tersimpan tidak dapat didekripsi lagi dan harus
# disimpan ulang lewat panel admin.
# ------------------------------------------------------------------
encryption.key = hex2bin:GANTI_DENGAN_64_HEX_ACAK

# ------------------------------------------------------------------
# Seeder akun owner (opsional, hanya untuk instalasi baru)
# AdminSeeder menolak berjalan tanpa SEED_OWNER_EMAIL dan
# SEED_OWNER_PASSWORD (minimal 16 karakter). Hapus setelah dipakai.
# ------------------------------------------------------------------
# SEED_OWNER_EMAIL = owner@domain-anda.test
# SEED_OWNER_PASSWORD = ganti-dengan-string-acak-minimal-16-karakter

# ------------------------------------------------------------------
# WhatsApp Gateway (wa-gateway/server.js)
# WAJIB. Server menolak start tanpa nilai ini. Minimal 16 karakter.
# Nilai yang sama harus diisi di /admin/whatsapp/settings.
# ------------------------------------------------------------------
# WA_GATEWAY_KEY = ganti-dengan-string-acak-minimal-16-karakter
# WA_GATEWAY_URL = http://127.0.0.1:3000

# ------------------------------------------------------------------
# Telegram Bot (opsional — fitur bot mati bila kosong)
# Ambil token dari @BotFather. Secret webhook diisi oleh Telegram saat
# Anda mendaftarkan webhook.
# ------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN =
# TELEGRAM_WEBHOOK_SECRET =

# ------------------------------------------------------------------
# Wablas (opsional — alternatif driver WhatsApp)
# ------------------------------------------------------------------
# wablas.baseUrl = https://console.wablas.com/api
# wablas.token =
# Environment configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# CodeIgniter 4 Writable Files & Cache
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

/writable/backups/*
!/writable/backups/.gitkeep

# Public Uploads (User uploaded assets)
/public/uploads/*
!/public/uploads/index.html
!/public/uploads/.gitkeep

# Composer Dependencies
/vendor/
composer.phar
.phpunit.result.cache

# Node / Frontend Dependencies
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Temporary & Tooling Directories
.hermes/
graphify-out/
.gemini/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

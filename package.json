{
  "name": "ayong-store",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify && tailwindcss -c ./tailwind.public.config.js -i ./resources/css/public.css -o ./public/assets/css/public.css --minify",
    "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
